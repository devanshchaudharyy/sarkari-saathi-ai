# Copy to .env.production for local production-style startup, or use host variables.
# Generate a secret; the example placeholder is deliberately rejected at startup.
PORT=5176
MONGO_URI=mongodb://127.0.0.1:27017/sarkari_saathi_ai
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5176
NODE_ENV=production
SERVE_CLIENT=true

# Local preview writes private files under ignored reports/mail; no email is sent.
# Remote production requires MAIL_MODE=smtp or disabled; previews require loopback.
MAIL_MODE=preview
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# SMTP_FROM=verified-sender@example.com
