{
  "info": {
    "name": "SarkariSaathi document guidance and reliability",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5176/api"
    }
  ],
  "item": [
    {
      "name": "Document guides - pmsby",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/schemes/pmsby/documents"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Reviewed public guide',()=>{pm.response.to.have.status(200);const d=pm.response.json();pm.expect(d.success).to.eql(true);pm.expect(d.guide.available).to.eql(true);pm.expect(d.guide.items.length).to.be.above(0);});"
            ]
          }
        }
      ]
    },
    {
